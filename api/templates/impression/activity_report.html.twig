{% extends 'impression/_layout.html.twig' %}

{% block extra_styles %}
<style>
    body { font-family: DejaVu Sans, sans-serif; color: #172033; font-size: 10pt; }
    .report-hero { background: #1e3a5f; color: #fff; padding: 18px 20px; margin-bottom: 14px; }
    .report-hero h1 { margin: 0 0 5px; font-size: 22pt; }
    .report-hero p { margin: 2px 0; }
    .report-summary { border: 1px solid #d8e0ec; background: #f5f8fc; padding: 10px 12px; margin-bottom: 14px; }
    .project { page-break-inside: avoid; border: 1px solid #d8e0ec; margin: 0 0 14px; }
    .project__head { background: #e8f0fb; border-bottom: 1px solid #d8e0ec; padding: 9px 11px; }
    .project__head h2 { margin: 0; color: #1e3a5f; font-size: 14pt; }
    .project__head p { margin: 2px 0 0; color: #5c6b82; font-size: 9pt; }
    .report-table { width: 100%; border-collapse: collapse; }
    .report-table th, .report-table td { border: 1px solid #d8e0ec; padding: 5px 7px; text-align: left; vertical-align: top; }
    .report-table th { background: #f5f8fc; color: #334155; font-size: 9pt; }
    .report-table td { font-size: 9pt; }
    .site-title { font-weight: bold; color: #172033; }
    .site-subtitle { color: #5c6b82; font-size: 8.5pt; margin-top: 2px; }
    .status { display: inline-block; padding: 2px 7px; border-radius: 10px; background: #64748b; color: #fff; font-weight: bold; }
    .status--completed { background: #15803d; }
    .status--in_progress { background: #b45309; }
    .status--blocked { background: #b91c1c; }
    .attachments { display: grid; gap: 6px; }
    .attachment { page-break-inside: avoid; }
    .attachment img { width: 100%; max-height: 160px; object-fit: contain; border: 1px solid #d8e0ec; }
    .caption { color: #5c6b82; font-size: 8.5pt; margin-top: 3px; }
</style>
{% endblock %}

{% block content %}
<div class="report-hero">
    <h1>Rapport d’activité</h1>
    <p><strong>{{ report.code }}</strong> — {{ report.period }}</p>
    <p>{{ profile.shop_name }}</p>
</div>

<div class="report-summary">
    <strong>Synthèse</strong>
    <p>{{ report.description }}</p>
    <p>{{ report.sites|length }} site{{ report.sites|length > 1 ? 's' : '' }} documenté{{ report.sites|length > 1 ? 's' : '' }}</p>
</div>

{% for group in report.groups %}
<section class="project">
    <div class="project__head">
        <h2>{{ group.label }}</h2>
        <p>{{ group.lines|length }} site{{ group.lines|length > 1 ? 's' : '' }}</p>
    </div>
    <table class="report-table">
        <thead>
            <tr>
                <th>Site</th>
                <th>Statut</th>
                <th>Tâche prévue</th>
                <th>Observation</th>
                <th>Chef d'équipe</th>
                <th>Fichiers</th>
            </tr>
        </thead>
        <tbody>
            {% for site in group.lines %}
            <tr>
                <td>
                    <div class="site-title">{{ site.code ? site.code ~ ' — ' : '' }}{{ site.title }}</div>
                    {% if site.groupLabel %}<div class="site-subtitle">{{ site.groupLabel }}</div>{% endif %}
                </td>
                <td><span class="status status--{{ site.statusKey }}">{{ site.status }}</span></td>
                <td>{{ site.plannedTask ?: '—' }}</td>
                <td>{{ site.observation ?: '—' }}</td>
                <td>{{ site.teamLeader ?: '—' }}</td>
                <td>
                    {% if site.attachments|length %}
                        <div class="attachments">
                            {% for file in site.attachments %}
                                <div class="attachment">
                                    {% if file.image %}
                                        <img src="{{ file.image }}" alt="">
                                    {% endif %}
                                    <div class="caption">{{ file.description ?: file.title }}</div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        —
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</section>
{% endfor %}
{% endblock %}
