{% extends 'impression/_layout.html.twig' %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}
{% block extra_styles %}
<style>
    body.is-portrait, body.is-landscape { font: 11pt/1.3 Arial, 'DejaVu Sans', sans-serif; color: #000; padding: 0; }
    @page { size: {{ page.css_page_size }}; margin: {{ page.margin_mm }}mm; }
    .delivery-sheet { width: 100%; }
    .delivery-table, .delivery-space, .delivery-signatures { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .delivery-table th, .delivery-table td, .delivery-space td, .delivery-signatures td { border: 1px solid #000; padding: 5px 7px; overflow-wrap: break-word; word-wrap: break-word; }
    .delivery-table .delivery-title { background: #afadad; font-size: 21pt; text-align: center; padding: 10px; }
    .delivery-meta td { font-weight: bold; text-align: center; height: 17mm; }
    .delivery-logos td { text-align: center; height: 30mm; vertical-align: middle; font-weight: bold; }
    .delivery-logos img { max-width: 100%; max-height: 24mm; width: auto; }
    .delivery-table thead { display: table-header-group; }
    .delivery-table .delivery-object { text-align: center; font-weight: bold; padding: 8px 7px; }
        .delivery-table .column-head th { background: #807b7b; color: #000; text-align: center; height: 10mm; }
    .delivery-line td { height: 7mm; padding: 2px 7px; vertical-align: middle; white-space: pre-line; }
    .delivery-line td:nth-child(2) { text-align: right; }
        .delivery-line td:nth-child(3) { text-align: center; }
    tr { page-break-inside: avoid; break-inside: avoid; }
    .delivery-space td { height: 55mm; border-top: 0; }
    .delivery-signatures { page-break-inside: avoid; break-inside: avoid; }
    .delivery-signatures td { height: 28mm; vertical-align: middle; text-align: center; border-top: 0; font-weight: bold; }
    @media screen { body.render-html { max-width: 210mm; margin: 15px auto; padding: {{ page.margin_mm }}mm; } }
</style>
{% endblock %}
{% block content %}
<div class="delivery-sheet">
<table class="delivery-table">
    <colgroup><col style="width:57%"><col style="width:21%"><col style="width:22%"></colgroup>
    <thead>
        <tr><th colspan="3" class="delivery-title">BON DE LIVRAISON</th></tr>
        <tr class="delivery-meta"><td>{{ data.clientTitle }}</td><td>BON DE COMMANDE N°<br>{{ data.number }}</td><td>ENT</td></tr>
        <tr class="delivery-logos"><td>{% if data.clientLogo %}<img src="{{ data.clientLogo }}" alt="Logo {{ data.clientTitle }}">{% endif %}</td><td>{{ data.dateDisplay }}</td><td>{% if profile.logo_url %}<img src="{{ profile.logo_url }}" alt="Logo {{ profile.shop_name }}">{% endif %}</td></tr>
        {% if data.object %}<tr><th colspan="3" class="delivery-object">{{ data.object }}</th></tr>{% endif %}
                <tr class="column-head"><th>ITEM</th><th>Quantité</th><th>Observation</th></tr>
    </thead>
    <tbody>
        {% for line in data.lines %}<tr class="delivery-line"><td>{{ line.description }}</td><td>{{ line.quantity }}</td><td>{{ line.observation }}</td></tr>{% endfor %}
        {% if data.lines|length < 10 %}{% for i in 1..(10 - data.lines|length) %}<tr class="delivery-line delivery-empty"><td>&nbsp;</td><td></td><td></td></tr>{% endfor %}{% endif %}
    </tbody>
</table>
<table class="delivery-space"><colgroup><col style="width:78%"><col style="width:22%"></colgroup><tr><td></td><td></td></tr></table>
<table class="delivery-signatures"><colgroup><col style="width:78%"><col style="width:22%"></colgroup><tr><td>{{ data.clientTitle }}</td><td>ENT</td></tr></table>
</div>
{% endblock %}
