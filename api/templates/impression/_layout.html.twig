<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ data.title|default('Document') }} — {{ profile.shop_name }}</title>
    <style>
        * { box-sizing: border-box; }

        :root {
            --accent: #0f4c5c;
            --accent-soft: #e8f1f3;
            --muted: #5b6b73;
            --border: #c9d4d9;
            --text: #14212b;
            --row-alt: #f7fafb;
        }

        html, body { background: #fff; }

        body {
            font-family: 'DejaVu Sans', Arial, Helvetica, sans-serif;
            font-size: 12px;
            color: var(--text);
            line-height: 1.45;
            margin: 0;
            padding: {{ page.margin_mm|default(10) }}mm;
        }

        @page {
            size: {{ page.css_page_size|default('210mm 297mm') }};
            margin: 0;
        }

        body.is-landscape { font-size: 11px; }
        body.is-portrait { font-size: 12px; }

        .doc-header {
            display: flex;
            align-items: stretch;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
            padding-bottom: 8px;
            border-bottom: 2px solid var(--accent);
        }
        .doc-header__left,
        .doc-header__right {
            flex: 1 1 0;
            min-width: 0;
        }
        .doc-header__left {
            display: flex;
            align-items: stretch;
            justify-content: flex-start;
        }
        .doc-header__center {
            flex: 1.4 1 0;
            text-align: center;
            min-width: 0;
            padding: 0 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .doc-header__right {
            text-align: right;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .doc-header__logo {
            display: block;
            width: 100%;
            height: 28mm;
            max-width: 100%;
            object-fit: contain;
            object-position: left center;
        }
        .doc-header__name {
            display: block;
            font-family: 'Cooper', 'Arial MT Rounded', 'DejaVu Sans', Arial Black, 'Arial Black', Arial, Helvetica, sans-serif;
            font-weight: 900;
            font-size: 24px;
            color: var(--text);
            line-height: 1.15;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .doc-header__meta { color: var(--muted); font-size: 10.5px; }

        .doc-title-band {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 12px;
            margin: 10px 0 10px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border);
        }
        .doc-title { font-size: 17px; font-weight: 700; color: var(--text); margin: 0; }
        .doc-number-badge {
            border: 1px solid var(--accent);
            color: var(--accent);
            border-radius: 4px;
            padding: 4px 10px;
            font-weight: 700;
            font-size: 11px;
            white-space: nowrap;
        }
        .doc-date { color: var(--muted); font-size: 10.5px; text-align: right; }

        .doc-meta { color: var(--muted); font-size: 11px; margin: 2px 0; }
        .doc-meta strong { color: var(--text); }

        .info-card {
            border: 1px solid var(--border);
            border-left: 3px solid var(--accent);
            background: #f9fbfd;
            padding: 8px 12px;
            margin: 10px 0 14px;
        }

        .doc-table {
            width: 100%;
            border-collapse: collapse;
            margin: 12px 0;
            font-size: 11px;
        }
        .doc-table th, .doc-table td {
            border: 1px solid var(--border);
            padding: 7px 8px;
            text-align: left;
            vertical-align: top;
        }
        .doc-table thead th {
            background: var(--accent);
            color: #fff;
            font-weight: 700;
            border-color: var(--accent);
            letter-spacing: 0.02em;
        }
        .doc-table tbody tr:nth-child(even) td { background: var(--row-alt); }
        .doc-table .empty { text-align: center; color: var(--muted); }
        .doc-table .col-num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }

        body.is-landscape .doc-table { font-size: 10.5px; }
        body.is-landscape .doc-table th, body.is-landscape .doc-table td { padding: 5px 6px; }

        .doc-footer {
            margin-top: 24px;
            text-align: center;
            font-size: 10px;
            color: var(--muted);
            padding-top: 8px;
            border-top: 1px solid var(--border);
        }

        /* Ticket thermique 80 mm */
        body.receipt-80mm {
            width: 76mm;
            font-size: 12px;
            font-weight: 600;
            color: #000;
            padding: 3mm 2mm;
        }
        body.receipt-80mm .doc-header {
            flex-direction: column;
            align-items: center;
            text-align: center;
            border-bottom: none;
            padding-bottom: 4px;
            margin-bottom: 4px;
            gap: 4px;
        }
        body.receipt-80mm .doc-header__left,
        body.receipt-80mm .doc-header__center,
        body.receipt-80mm .doc-header__right {
            flex: none;
            width: 100%;
            text-align: center;
            justify-content: center;
        }
        body.receipt-80mm .doc-header__logo {
            width: 100%;
            height: 18mm;
            max-width: 100%;
            object-fit: contain;
            object-position: center;
            filter: grayscale(100%) contrast(350%);
        }
        body.receipt-80mm .doc-header__name { font-size: 17px; font-weight: 900; }
        body.receipt-80mm .doc-header__meta { color: #000; font-size: 10.5px; }
        body.receipt-80mm .doc-header::after {
            content: '';
            display: block;
            width: 100%;
            border-top: 2px solid #000;
            margin-top: 6px;
        }
        body.receipt-80mm .doc-footer {
            margin-top: 10px;
            padding-top: 6px;
            border-top: 2px solid #000;
            color: #000;
            font-size: 11px;
            font-weight: 700;
        }

        @media print {
            .no-print { display: none !important; }
            * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            body.receipt-80mm { page: ticket; }
            @page ticket { size: 80mm auto; margin: 0; }
        }
    </style>
    {% block extra_styles %}{% endblock %}
</head>
<body class="format-{{ page.format|default('a4') }} {{ page.format|default('a4') == 'receipt_80mm' ? 'receipt-80mm' : '' }} {{ page.orientation|default('portrait') == 'landscape' ? 'is-landscape' : 'is-portrait' }}">
    {% block header %}
        {% include 'impression/_header.html.twig' %}
    {% endblock %}

    {% block content %}{% endblock %}

    {% block footer %}
        {% if profile.footer_text %}
            <div class="doc-footer">{{ profile.footer_text }}</div>
        {% endif %}
    {% endblock %}

    {% if auto_print %}
        <script>window.onload = function () { window.print(); };</script>
    {% endif %}
</body>
</html>
