<script>
(() => {
    const source = document.getElementById('invoice-content');
    const footer = document.getElementById('invoice-footer');
    const blocks = Array.from(source.children);
    const pages = document.createElement('div');
    pages.className = 'invoice-pages';
    source.before(pages);
    source.remove();
    footer.remove();
    const widthMm = {{ (page.orientation == 'landscape' ? (page.format == 'a5' ? 210 : 297) : (page.format == 'a5' ? 148 : 210)) - 12 }};
    const heightMm = {{ (page.orientation == 'landscape' ? (page.format == 'a5' ? 148 : 210) : (page.format == 'a5' ? 210 : 297)) - 12 }};
    function paginate() {
        pages.replaceChildren();
        let sheet, body, content;
        function newPage() {
            sheet = document.createElement('main');
            sheet.className = 'invoice-sheet';
            sheet.style.width = widthMm + 'mm';
            sheet.style.height = heightMm + 'mm';
            body = document.createElement('div');
            body.className = 'invoice-sheet-body';
            content = document.createElement('section');
            content.className = 'invoice-sheet-content';
            body.append(content);
            sheet.append(body, footer.cloneNode(true));
            sheet.lastElementChild.removeAttribute('id');
            pages.append(sheet);
            if (pages.children.length > 1) {
                const label = document.createElement('div');
                label.className = 'continuation';
                const title = document.createElement('span');
                title.textContent = {{ (data.documentLabel|upper ~ ' · Suite')|json_encode(15)|raw }};
                const number = document.createElement('span');
                number.textContent = {{ data.invoice.number|json_encode(15)|raw }};
                label.append(title, number);
                content.append(label);
            }
        }
        function overflowing() {
            const last = content.lastElementChild;
            return (last && last.getBoundingClientRect().bottom > sheet.lastElementChild.getBoundingClientRect().top - 12)
                || content.scrollHeight > content.clientHeight + 1
                || body.scrollHeight > body.clientHeight + 1;
        }
        newPage();
        for (const block of blocks) {
            if (block.classList.contains('brand-banner')) {
                body.prepend(block.cloneNode(true));
            } else if (block.classList.contains('invoice-table')) {
                let table = block.cloneNode(true);
                const rows = Array.from(table.tBodies[0].rows);
                table.tBodies[0].replaceChildren();
                content.append(table);
                for (const row of rows) {
                    table.tBodies[0].append(row);
                    if (overflowing()) {
                        row.remove();
                        if (!table.tBodies[0].rows.length) table.remove();
                        newPage();
                        table = block.cloneNode(true);
                        table.tBodies[0].replaceChildren(row);
                        content.append(table);
                    }
                }
            } else {
                const node = block.cloneNode(true);
                content.append(node);
                if (overflowing() && content.children.length > 1) {
                    node.remove();
                    newPage();
                    content.append(node);
                }
            }
        }
        Array.from(pages.children).forEach((page, i) => {
            page.querySelector('.footer-page').textContent = 'Page ' + (i + 1) + ' / ' + pages.children.length;
        });
    }
    window.addEventListener('load', paginate, { once: true });
    window.addEventListener('beforeprint', paginate);
    let resizeTimer;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(paginate, 120);
    });
})();
</script>
