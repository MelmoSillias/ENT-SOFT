# Super Cargo API — environment template
# Copy to .env and adjust values for your machine.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_to_a_random_secret
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8040
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# XAMPP / MySQL (default)
DATABASE_URL="mysql://root:@127.0.0.1:3306/super_cargo?serverVersion=8.0.32&charset=utf8mb4"

# PostgreSQL (alternative)
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/super_cargo?serverVersion=16&charset=utf8"

# SQLite (quick local test, no server required)
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> jwt (access tokens — HMAC custom, pas Lexik) ###
# Secret de signature des access tokens JWT.
# Si absent, APP_SECRET est utilisé automatiquement.
JWT_ACCESS_SECRET=
###< jwt (access tokens — HMAC custom, pas Lexik) ###

###> frankfurter exchange rates ###
FRANKFURTER_API_URL=https://api.frankfurter.dev
FRANKFURTER_CACHE_TTL=3600
###< frankfurter exchange rates ###
