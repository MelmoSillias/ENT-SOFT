# Frontend environment
VITE_API_URL=http://localhost:8000/api

# Deployment mode for connectivity monitoring:
# - online: browser internet + API health (cloud / Dokploy)
# - local: API health only (agency LAN, no internet alert)
VITE_DEPLOYMENT_MODE=online

# Interval between API health polls (ms)
VITE_CONNECTIVITY_POLL_MS=15000
