# ENT-SOFT — variables Docker Compose
# Copier vers .env à la racine de Symfony&Vue/ avant : docker compose up

# --- Application ---
APP_SECRET=change_me_to_a_long_random_secret
JWT_ACCESS_SECRET=
DEFAULT_URI=http://localhost:8080

# --- Base de données MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=ent_soft
MYSQL_USER=ent_soft
MYSQL_PASSWORD=change_me_db_password

# --- API Symfony ---
APP_ENV=prod
APP_DEBUG=0
RUN_MIGRATIONS=true
RUN_LOAD_FIXTURES=true
CORS_ALLOW_ORIGIN='^https?://(.*)$'

# --- Frontend ---
WEB_PORT=8080
VITE_API_URL=/api
API_UPSTREAM_HOST=api
API_UPSTREAM_PORT=80

# --- Proxy Symfony ---
SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR
SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-host,x-forwarded-proto
