# ENT-SOFT — variables Docker Compose
# Copier vers .env à la racine avant : docker compose up

# --- Application ---
APP_SECRET=change_me_to_a_long_random_secret
JWT_ACCESS_SECRET=
DEFAULT_URI=http://localhost:8080

# --- Base de données SQLite ---
# Fichier persisté dans le volume Docker sqlite_data
DATABASE_URL=sqlite:////var/www/html/var/database/data.db
SQLITE_DATABASE_PATH=/var/www/html/var/database/data.db

# --- API Symfony ---
APP_ENV=prod
APP_DEBUG=0
RUN_MIGRATIONS=true
RUN_LOAD_FIXTURES=true
CORS_ALLOW_ORIGIN='^https?://(.*)$'

# --- Frontend ---
WEB_PORT=8080
VITE_API_URL=/api
API_UPSTREAM_HOST=api
API_UPSTREAM_PORT=80

# --- Proxy Symfony ---
SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR
SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-host,x-forwarded-proto
